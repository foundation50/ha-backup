#!/usr/bin/env python3
"""Scheduled, atomic backups of whitelisted Home Assistant paths to GitHub."""

from __future__ import annotations

import json
import logging
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path


OPTIONS_PATH = Path("/data/options.json")
ALLOWED_ROOTS = (Path("/config"), Path("/share"), Path("/ssl"), Path("/media"))
MANIFEST_NAME = ".ha-github-backup-manifest.json"
LOG = logging.getLogger("github-backup")


class ConfigurationError(ValueError):
    """Raised when add-on options are invalid."""


class GitError(RuntimeError):
    """Raised for an unsuccessful Git command."""


@dataclass(frozen=True)
class Settings:
    repository: str
    branch: str
    schedule: str
    sources: tuple[Path, ...]
    backup_path: str
    run_on_startup: bool
    token: str


def read_settings() -> Settings:
    try:
        options = json.loads(OPTIONS_PATH.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise ConfigurationError(f"Unable to read {OPTIONS_PATH}: {error}") from error

    repository = options.get("repository", "").strip()
    environment_token = os.environ.get("GITHUB_TOKEN")
    option_token = options.get("github_token", "")
    if environment_token is not None:
        token = environment_token.strip()
    elif isinstance(option_token, str):
        token = option_token.strip()
    else:
        raise ConfigurationError("github_token must be a string")
    branch = options.get("branch", "").strip()
    schedule = options.get("schedule", "").strip()
    backup_path = options.get("backup_path", "").strip("/")
    raw_sources = options.get("whitelist", [])

    if not re.fullmatch(r"[\w.-]+/[\w.-]+", repository):
        raise ConfigurationError("repository must be in the form OWNER/REPOSITORY")
    if not token:
        raise ConfigurationError("Set GITHUB_TOKEN or github_token")
    if not branch:
        raise ConfigurationError("branch must not be empty")
    if not backup_path or any(part in (".", "..") for part in backup_path.split("/")):
        raise ConfigurationError("backup_path must be a safe, non-empty relative path")
    if not isinstance(raw_sources, list) or not raw_sources:
        raise ConfigurationError("whitelist must contain at least one path")

    validated_sources = sorted(
        {validate_source_path(str(source)) for source in raw_sources},
        key=lambda path: len(path.parts),
    )
    sources = tuple(
        source
        for source in validated_sources
        if not any(source.is_relative_to(parent) for parent in validated_sources if parent != source)
    )
    CronSchedule(schedule)
    return Settings(
        repository=repository,
        branch=branch,
        schedule=schedule,
        sources=sources,
        backup_path=backup_path,
        run_on_startup=bool(options.get("run_on_startup", True)),
        token=token,
    )


def validate_source_path(raw_path: str) -> Path:
    path = Path(raw_path)
    if not path.is_absolute():
        raise ConfigurationError(f"Whitelist path must be absolute: {raw_path}")
    try:
        resolved = path.resolve(strict=True)
    except OSError as error:
        raise ConfigurationError(f"Whitelist path cannot be resolved: {raw_path}") from error
    if not any(resolved.is_relative_to(root) for root in ALLOWED_ROOTS):
        roots = ", ".join(str(root) for root in ALLOWED_ROOTS)
        raise ConfigurationError(f"Whitelist path must be below one of: {roots}: {raw_path}")
    return resolved


def remote_path(settings: Settings, source: Path, child: Path | None = None) -> str:
    relative = source.relative_to("/")
    if child is not None:
        relative = relative / child.relative_to(source)
    return f"{settings.backup_path}/{relative.as_posix()}"


def collect_files(settings: Settings) -> dict[str, Path]:
    files: dict[str, Path] = {}
    for source in settings.sources:
        if source.is_file():
            files[remote_path(settings, source)] = source
            continue
        for child in sorted(source.rglob("*")):
            if child.is_symlink():
                LOG.warning("Skipping symlink: %s", child)
            elif child.is_file():
                files[remote_path(settings, source, child)] = child
    return files


def read_manifest(manifest_path: Path, backup_root: Path) -> set[str]:
    if not manifest_path.exists():
        return set()
    try:
        manifest = json.loads(manifest_path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise GitError(f"Existing backup manifest is invalid: {error}") from error
    if not isinstance(manifest, list) or not all(isinstance(path, str) for path in manifest):
        raise GitError("Existing backup manifest must contain a list of file paths")

    validated_paths = set(manifest)
    for path in validated_paths:
        local_path = backup_root.parent / path
        if (
            Path(path).is_absolute()
            or ".." in Path(path).parts
            or not local_path.is_relative_to(backup_root)
        ):
            raise GitError(f"Existing backup manifest contains an unsafe path: {path}")
    return validated_paths


def apply_backup_files(settings: Settings, files: dict[str, Path], worktree: Path) -> None:
    backup_root = worktree / settings.backup_path
    manifest_path = backup_root / MANIFEST_NAME
    previous_files = read_manifest(manifest_path, backup_root)

    for path in previous_files - set(files):
        local_path = worktree / path
        if local_path.is_file() or local_path.is_symlink():
            local_path.unlink()

    for path, source_path in files.items():
        destination = worktree / path
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source_path, destination, follow_symlinks=False)

    backup_root.mkdir(parents=True, exist_ok=True)
    manifest_path.write_text(json.dumps(sorted(files), indent=2) + "\n")


def create_askpass_script(worktree: Path) -> Path:
    askpass = worktree / "git-askpass"
    askpass.write_text(
        """#!/bin/sh
case "$1" in
  *Username*) printf '%s\\n' x-access-token ;;
  *Password*) printf '%s\\n' "$GITHUB_TOKEN" ;;
  *) exit 1 ;;
esac
"""
    )
    askpass.chmod(0o700)
    return askpass


def git_environment(settings: Settings, askpass: Path) -> dict[str, str]:
    environment = os.environ.copy()
    environment.update(
        {
            "GIT_ASKPASS": str(askpass),
            "GIT_ASKPASS_REQUIRE": "force",
            "GIT_CONFIG_GLOBAL": os.devnull,
            "GIT_CONFIG_NOSYSTEM": "1",
            "GIT_TERMINAL_PROMPT": "0",
            "GITHUB_TOKEN": settings.token,
        }
    )
    return environment


def run_git(
    arguments: list[str], worktree: Path, environment: dict[str, str], check: bool = True
) -> subprocess.CompletedProcess[str]:
    try:
        result = subprocess.run(
            ["git", *arguments],
            cwd=worktree,
            env=environment,
            check=False,
            capture_output=True,
            text=True,
        )
    except OSError as error:
        raise GitError(f"Unable to execute git: {error}") from error
    if check and result.returncode:
        detail = (result.stderr or result.stdout).strip()
        raise GitError(f"Git {' '.join(arguments)} failed: {detail}")
    return result


def sync(settings: Settings) -> None:
    LOG.info("Collecting files from %d whitelist path(s)", len(settings.sources))
    files = collect_files(settings)
    LOG.info("Collected %d file(s); preparing Git worktree", len(files))
    with tempfile.TemporaryDirectory(prefix="github-backup-") as temporary_directory:
        worktree = Path(temporary_directory)
        askpass = create_askpass_script(worktree)
        environment = git_environment(settings, askpass)
        remote_url = f"https://github.com/{settings.repository}.git"

        run_git(["init"], worktree, environment)
        run_git(["remote", "add", "origin", remote_url], worktree, environment)
        LOG.info("Fetching %s branch", settings.branch)
        run_git(["fetch", "--depth=1", "origin", settings.branch], worktree, environment)
        run_git(["checkout", "--force", "-B", settings.branch, "FETCH_HEAD"], worktree, environment)

        LOG.info("Applying backup files to Git worktree")
        apply_backup_files(settings, files, worktree)
        run_git(["add", "--all", "--", settings.backup_path], worktree, environment)
        staged_changes = run_git(
            ["diff", "--cached", "--quiet", "--", settings.backup_path],
            worktree,
            environment,
            check=False,
        )
        if staged_changes.returncode == 0:
            LOG.info("Backup is already current; no commit created")
            return
        if staged_changes.returncode != 1:
            detail = (staged_changes.stderr or staged_changes.stdout).strip()
            raise GitError(f"Git diff --cached failed: {detail}")

        LOG.info("Creating backup commit")
        run_git(
            [
                "-c",
                "user.name=Home Assistant GitHub Backup",
                "-c",
                "user.email=github-backup@home-assistant.local",
                "commit",
                "-m",
                f"Home Assistant backup: {datetime.now().astimezone().isoformat(timespec='seconds')}",
            ],
            worktree,
            environment,
        )
        LOG.info("Pushing backup commit to %s@%s", settings.repository, settings.branch)
        run_git(
            ["push", "origin", f"HEAD:refs/heads/{settings.branch}"], worktree, environment
        )
    LOG.info("Synced %d file(s) to %s@%s", len(files), settings.repository, settings.branch)


class CronSchedule:
    def __init__(self, expression: str) -> None:
        fields = expression.split()
        if len(fields) != 5:
            raise ConfigurationError("schedule must be a five-field cron expression")
        limits = ((0, 59), (0, 23), (1, 31), (1, 12), (0, 6))
        self.values = tuple(
            self._parse_field(field, low, high) for field, (low, high) in zip(fields, limits)
        )
        self.day_of_month_wildcard = fields[2] == "*"
        self.day_of_week_wildcard = fields[4] == "*"

    @staticmethod
    def _parse_field(field: str, low: int, high: int) -> set[int]:
        values: set[int] = set()
        for item in field.split(","):
            match = re.fullmatch(r"(\*|\d+(?:-\d+)?)(?:/(\d+))?", item)
            if match is None:
                raise ConfigurationError(f"Invalid cron field: {field}")
            span, step_text = match.groups()
            step = int(step_text or "1")
            if step < 1:
                raise ConfigurationError(f"Cron step must be positive: {field}")
            if span == "*":
                start, end = low, high
            elif "-" in span:
                start, end = map(int, span.split("-"))
            else:
                start = end = int(span)
            if start < low or end > high or start > end:
                raise ConfigurationError(f"Cron value out of range: {field}")
            values.update(range(start, end + 1, step))
        return values

    def matches(self, now: datetime) -> bool:
        minute, hour, day, month, weekday = self.values
        if now.minute not in minute or now.hour not in hour or now.month not in month:
            return False
        cron_weekday = (now.weekday() + 1) % 7
        dom_match, dow_match = now.day in day, cron_weekday in weekday
        if self.day_of_month_wildcard or self.day_of_week_wildcard:
            return dom_match and dow_match
        return dom_match or dow_match


def main() -> int:
    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
    try:
        settings = read_settings()
    except ConfigurationError as error:
        LOG.error("Invalid configuration: %s", error)
        return 2

    schedule = CronSchedule(settings.schedule)
    LOG.info(
        "Backup service started for %s@%s; schedule: %s; startup backup: %s",
        settings.repository,
        settings.branch,
        settings.schedule,
        "enabled" if settings.run_on_startup else "disabled",
    )
    if settings.run_on_startup:
        LOG.info("Running startup backup")
        try:
            sync(settings)
        except (GitError, OSError) as error:
            LOG.error("Initial backup failed: %s", error)
    else:
        LOG.info("Startup backup disabled; waiting for the next scheduled backup")

    last_run_minute: tuple[int, int, int, int, int] | None = None
    while True:
        now = datetime.now().astimezone()
        minute_key = (now.year, now.month, now.day, now.hour, now.minute)
        if minute_key != last_run_minute and schedule.matches(now):
            last_run_minute = minute_key
            try:
                sync(settings)
            except (GitError, OSError) as error:
                LOG.error("Scheduled backup failed: %s", error)
        time.sleep(5)


if __name__ == "__main__":
    sys.exit(main())
